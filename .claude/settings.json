{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(java -version:*)",
      "Bash(javac -version:*)",
      "Bash(jshell --version:*)",
      "Bash(pwd:*)",

      "Read(./.env.example)",
      "Edit(./.env.example)",
      "Write(./.env.example)",

      "Bash(make check:*)",
      "Bash(make format:*)",
      "Bash(make test:*)",

      "Bash(gradle -version:*)",
      "Bash(gradle tasks:*)",
      "Bash(gradle projects:*)",
      "Bash(gradle properties:*)",
      "Bash(gradle dependencies:*)",
      "Bash(gradle dependencyInsight:*)",
      "Bash(gradle compileJava:*)",
      "Bash(gradle classes:*)",
      "Bash(gradle test:*)",
      "Bash(gradle check:*)",
      "Bash(gradle build:*)",
      "Bash(gradle assemble:*)",
      "Bash(gradle clean:*)",
      "Bash(gradle spotlessApply:*)",
      "Bash(gradle spotlessCheck:*)",
      "Bash(gradle checkstyleMain:*)",
      "Bash(gradle checkstyleTest:*)",
      "Bash(gradle pmdMain:*)",
      "Bash(gradle pmdTest:*)",
      "Bash(gradle jacocoTestReport:*)",

      "Bash(./gradlew -version:*)",
      "Bash(./gradlew tasks:*)",
      "Bash(./gradlew projects:*)",
      "Bash(./gradlew properties:*)",
      "Bash(./gradlew dependencies:*)",
      "Bash(./gradlew dependencyInsight:*)",
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew classes:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew assemble:*)",
      "Bash(./gradlew clean:*)",
      "Bash(./gradlew spotlessApply:*)",
      "Bash(./gradlew spotlessCheck:*)",
      "Bash(./gradlew checkstyleMain:*)",
      "Bash(./gradlew checkstyleTest:*)",
      "Bash(./gradlew pmdMain:*)",
      "Bash(./gradlew pmdTest:*)",
      "Bash(./gradlew jacocoTestReport:*)",

      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git cat-file:*)",
      "Bash(git describe:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(git config --get:*)",

      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(which:*)",

      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",

      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl config view:*)",
      "Bash(kubectl config current-context:*)",
      "Bash(kubectl apply --dry-run=client:*)",
      "Bash(kubectl diff:*)",

      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(helm list:*)",
      "Bash(helm show:*)",

      "Bash(npx ctx7:*)",
      "Bash(npx -y ctx7:*)",

      "Bash(openssl req:*)",
      "Bash(openssl x509:*)",
      "Bash(openssl version:*)",

      "Write(./src/**)",
      "Write(./test/**)",
      "Write(./tests/**)",
      "Write(./deploy/**)",
      "Write(./docs/**)",
      "Write(./config/**)",
      "Edit(./src/**)",
      "Edit(./test/**)",
      "Edit(./tests/**)",
      "Edit(./deploy/**)",
      "Edit(./docs/**)",
      "Edit(./config/**)"
    ],
    "ask": [
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker push:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose build:*)",

      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl port-forward:*)",

      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",

      "Bash(gradle publish:*)",
      "Bash(gradle release:*)",
      "Bash(gradle bootRun:*)",
      "Bash(./gradlew publish:*)",
      "Bash(./gradlew release:*)",
      "Bash(./gradlew bootRun:*)",

      "Write(./.github/**)",
      "Edit(./.github/**)",
      "Edit(./pom.xml)",
      "Edit(./build.gradle)",
      "Edit(./build.gradle.kts)",
      "Edit(./settings.gradle)",
      "Edit(./settings.gradle.kts)",
      "Edit(./gradle.properties)",
      "Edit(./Dockerfile)",
      "Edit(./compose.yaml)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git clean:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git submodule:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree move:*)",

      "Bash(kubectl delete:*)",
      "Bash(kubectl drain:*)",
      "Bash(helm delete:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker network rm:*)",
      "Bash(docker system prune:*)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",

      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); echo \"$cmd\" | grep -qE '\\b(pip install|pip3 install|python -m pip install|pipx install|poetry add|poetry install|conda install|conda create|npm install|yarn add|pnpm add)\\b' && { echo 'Use Gradle for dependency management in this Java project — pip / poetry / conda / npm / yarn / pnpm installs are blocked' >&2; exit 2; } || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); case \"$file\" in *.java) cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; if [ -x ./gradlew ]; then ./gradlew spotlessApply >/dev/null 2>&1 || true; elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then gradle spotlessApply >/dev/null 2>&1 || true; fi ;; esac; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git -C \"$CLAUDE_PROJECT_DIR\" branch --show-current 2>/dev/null || echo unknown); changed=$(git -C \"$CLAUDE_PROJECT_DIR\" status --porcelain 2>/dev/null | wc -l | tr -d ' '); jq -nc --arg ctx \"Branch: $branch · $changed changed files\" '{hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: $ctx}}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; if [ -x ./mvnw ]; then ./mvnw -q -DskipTests compile 2>&1 | tail -10 || true; elif [ -f pom.xml ]; then mvn -q -DskipTests compile 2>&1 | tail -10 || true; elif [ -x ./gradlew ]; then ./gradlew compileJava 2>&1 | tail -10 || true; elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then gradle compileJava 2>&1 | tail -10 || true; fi"
          }
        ]
      }
    ]
  },
  "env": {
    "APP_ENV": "development",
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8",
    "GRADLE_OPTS": "-Dfile.encoding=UTF-8",
    "DISABLE_TELEMETRY": "1"
  }
}
